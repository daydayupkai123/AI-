# 数字员工服务器环境变量（复制为 /data/digital-employees/de.env，权限 600，不入库）
DE_RUNTIME=/data/digital-employees/runtime
DE_LLM_CONFIG=/data/digital-employees/app/deploy/llm.server.yaml
PLAYWRIGHT_BROWSERS_PATH=/data/digital-employees/browsers
DE_CDP_URL=http://127.0.0.1:9222

# 工作台对外监听
DE_HOST=0.0.0.0
DE_PORT=8090
# 访问口令（两项都填才启用；若存在 config/users.local.yaml 则改用账号登录，本口令自动失效）
DE_WEB_USER=
DE_WEB_PASSWORD=
# 工作台账号文件（默认 app/config/users.local.yaml；用 tools/ops/user_admin.py 维护）
# DE_USERS_FILE=/data/digital-employees/app/config/users.local.yaml

# 客户门户服务账号（内网统一认证免验证码）
DE_SESSION_MODE=password
DE_SERVICE_USER=
DE_SERVICE_PASSWORD=

# 客户模型网关 one.gt.cn 的令牌
GT_LLM_API_KEY=

# 资料完整性签名密钥（首次部署生成后不要更换）
DE_HMAC_KEY=
